# 变量必须以 VITE_ 为前缀才能暴露给外部读取

# 应用端口
VITE_APP_PORT=4096

# 代理前缀
VITE_APP_BASE_API=/dev-api

# 代理转发目标（开发环境代理指向的接口地址，默认走线上）
VITE_PROXY_TARGET=https://api.youlai.tech     # 线上
# VITE_PROXY_TARGET=http://localhost:8000     # 本地

# 接口地址（小程序/App 直连，H5 走代理用不到）
VITE_APP_API_URL=https://api.youlai.tech     # 线上
# VITE_APP_API_URL=http://localhost:8000     # 本地

# 应用监控地址（工作台-应用监控）
VITE_APP_MONITOR_URL=http://localhost:9090/wallboard
